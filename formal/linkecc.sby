# The instantiated codec is 256 bits wide, so this is BMC rather than unbounded:
# the retry state machine is tiny but the SAT problem is dominated by the XOR
# trees.  Depth 10 covers a full retry budget plus escalation.
[tasks]
bmc
cover

[options]
bmc:   mode bmc
bmc:   depth 10
cover: mode cover
cover: depth 10
multiclock off

[engines]
smtbmc yices

[script]
read -formal linkecc.v
prep -top fv_link_ecc

[files]
build/linkecc.v
